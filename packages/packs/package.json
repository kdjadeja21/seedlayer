{
  "name": "@seedlayer/packs",
  "version": "0.1.0",
  "description": "Presets and content packs for Seedlayer.",
  "keywords": [
    "seedlayer",
    "presets",
    "nextjs",
    "agents"
  ],
  "homepage": "https://github.com/kdjadeja21/seedlayer/tree/main/packages/packs#readme",
  "bugs": {
    "url": "https://github.com/kdjadeja21/seedlayer/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdjadeja21/seedlayer.git",
    "directory": "packages/packs"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "content",
    "presets",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@seedlayer/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.21"
  }
}
