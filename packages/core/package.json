{
  "name": "@seedlayer/core",
  "version": "0.1.0",
  "description": "Schema, config codes, resolver, and renderer for Seedlayer.",
  "author": {
    "name": "Krushnasinh Jadeja",
    "url": "https://github.com/kdjadeja21"
  },
  "keywords": [
    "seedlayer",
    "config",
    "schema",
    "scaffold"
  ],
  "homepage": "https://github.com/kdjadeja21/seedlayer/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/kdjadeja21/seedlayer/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdjadeja21/seedlayer.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.21"
  }
}
